.git
__pycache__
*.pyc
*.pyo
*.log
.env
.venv
.claude
data/
logs/
smartva_runs/
output/
private/
tests/
docs/
# Seed data that migrations read: a fresh database (the public demo) migrates
# from the image alone. tests/test_dockerignore_migration_data.py checks this.
!docs/icd-causegrp-mappings/migration-artifacts/icd10-2019-base-2026-04-27
!docs/icd-causegrp-mappings/migration-artifacts/cmea10-cod-2026-04-27
!docs/icd-causegrp-mappings/migration-artifacts/srs-india-cod-2026-04-27
!docs/icd-causegrp-mappings/migration-artifacts/who-2022-va-icd-cod-2026-04-27
!docs/icd-causegrp-mappings/migration-artifacts/who-2022-va-icd-cod-2026-revision
node_modules/
tasks/
backup/
resource/smartva
vendor/smartva-analyze/rust/target/
# The server image needs neither the offline station (desktop/, whose Rust
# target/ is gigabytes) nor the Rust ICD-11 host; docker/icd11 has its own
# ignore file.
desktop/
vendor/who-icd11-api/
vendor/smartva-analyze/rust/evidence/
resource/pyodk
security-audit/
bin/
*.amr
*.m4a
# The server needs only the Expo web export (EXPO_CLIENT_DIST default,
# app/routes/expo_client.py); the Android/iOS build trees are gigabytes.
mobile/**
!mobile/digitva-collect/dist
!mobile/digitva-collect/dist/**
**/node_modules
# ...but the web export ships expo-router's icons under assets/node_modules.
!mobile/digitva-collect/dist/assets/node_modules
!mobile/digitva-collect/dist/assets/node_modules/**
.env.*
!.env.demo.example
