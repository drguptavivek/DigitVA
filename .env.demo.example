# Environment of the public demo (docker-compose.demo.yml). Template only:
# copy it OUTSIDE the checkout, mode 0600, and fill it in. This repository
# also ignores .env.demo (.gitignore, .dockerignore), but keep the real file
# out of the checkout anyway.
#
#   install -m 600 .env.demo.example /data/digitva-demo.env
#   DD="docker compose --env-file /data/digitva-demo.env -f docker-compose.demo.yml"
#
# Always pass --env-file: without it compose reads the checkout's .env, which
# is the MAIN deployment's. Every value here is the demo's own. Never copy a
# key, password or S3 credential from the main .env. Runbook:
# docs/current-state/public-demo-deployment.md. A `$` in a password must be
# written `$$`.

# --- Image and ICD service --------------------------------------------------
# The image the main stack built, tagged for the demo (runbook step 2).
DEMO_APP_IMAGE=digitva-demo-app:CHANGE-ME
# The shared ICD container is reached over the external network digitva_icd
# (docker-compose.yml creates it; the demo app and worker join it, nothing
# else). The demo is not attached to main's default network.
DEMO_ICD11_API_BASE_URL=http://icd_api_service

# --- Host and ingress -------------------------------------------------------
DEMO_HOST=digitvademo.causeofdeathindia.com
# Public pages (/privacy, /contact, /data-requests); same meaning as the main
# PUBLIC_* keys. The contact form stays hidden: the demo suppresses mail.
DEMO_PUBLIC_ORG_NAME=
DEMO_PUBLIC_CONTACT_EMAIL=
DEMO_PUBLIC_GRIEVANCE_OFFICER=
DEMO_PUBLIC_POSTAL_ADDRESS=
# The DMZ reverse proxy's address AS THE INGRESS SEES IT (IP or CIDR): only its
# X-Forwarded-For is believed. A wrong value makes every visitor share one IP.
DEMO_PROXY_FROM=CHANGE-ME-DMZ-PROXY-IP
# Bind the ingress to the app host's private address, as APP_BIND_IP does for
# main; the security group admits the DMZ proxy on this port only.
DEMO_BIND_IP=127.0.0.1
DEMO_INGRESS_PORT=8001
# Directory holding server.crt and server.key (the app host's certificate;
# its name is the proxy's proxy_ssl_name).
DEMO_TLS_DIR=/etc/digitva-app/tls

# --- Secrets (generate each; none may equal a main value) -------------------
# python3 -c "import secrets; print(secrets.token_hex(32))"
DEMO_SECRET_KEY=CHANGE-ME
# openssl rand -hex 32
DEMO_CAPTCHA_HMAC_KEY=CHANGE-ME
# openssl rand -base64 32 | tr '+/' '-_'
DEMO_AUTH_FACTOR_ENCRYPTION_KEY=CHANGE-ME
# openssl rand -hex 24
DEMO_REDIS_PASSWORD=CHANGE-ME
# Registration-number keys: DEMO_PII_KEM_PUBLIC_KEY, DEMO_PII_KEM_KEY_ID and
# DEMO_PII_BLIND_INDEX_KEY are produced by scripts/generate_pii_keys.py
# (runbook step 2) and appended here; the private key is a file, outside the
# checkout, mode 0600, mounted into the app and worker only.
DEMO_PII_KEM_PRIVATE_KEY_PATH=/data/digitva-secrets/demo_pii_kem_private_key
DEMO_PII_KEM_PUBLIC_KEY=CHANGE-ME
DEMO_PII_KEM_KEY_ID=CHANGE-ME
DEMO_PII_BLIND_INDEX_KEY=CHANGE-ME

# --- Database (its own database and role; never the main one) ---------------
# External server, as in split production (verify-full against the CA; the CA
# file is mounted at the path in sslrootcert):
#   postgresql://minerva_demo:<password>@<DB_PRIVATE_IP>:5432/minerva_demo?sslmode=verify-full&sslrootcert=/etc/digitva-db/ca.crt
# A server on the same host (development): its published address, e.g.
#   postgresql://minerva_demo:<password>@host.docker.internal:5432/minerva_demo
# (the demo is not on main's network, so minerva_db_service does not resolve).
DEMO_DATABASE_URL=postgresql://minerva_demo:CHANGE-ME@DB-HOST:5432/minerva_demo
# Host path of the database CA, external server only (default: none).
# DEMO_DB_CA_FILE=/etc/digitva-db/ca.crt

# --- Attachments, SmartVA archives, exports and the nightly dump ------------
# S3 with a prefix of its own and an IAM user limited to that prefix (the
# runbook has the policy). 'local' keeps the dump on the host: not a backup.
DEMO_ATTACHMENT_STORE=s3
DEMO_S3_SERVER=https://s3.REGION.amazonaws.com
DEMO_S3_BUCKET=CHANGE-ME
DEMO_S3_REGION=REGION
DEMO_S3_ACCESS_KEY_ID=CHANGE-ME
DEMO_S3_SECRET_ACCESS_KEY=CHANGE-ME
DEMO_S3_PREFIX=demo/
# UTC; main dumps at 01:30.
DEMO_DB_BACKUP_TIME=02:30

# --- Switches ---------------------------------------------------------------
# 0 until a nightly dump is verified and a restore tested (runbook step 7).
# It gates the daily purge AND the eviction at the 500-account cap: while it
# is 0, sign-up at the cap is refused ("The demo is full").
DEMO_PURGE_ENABLED=0
# Bump on every upgrade: static assets are cached for 30 days under this value.
DEMO_STATIC_ASSET_VERSION=1
