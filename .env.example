# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# =============================================================================
# Application Secrets
# =============================================================================

# Flask secret key for session signing and CSRF protection
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-64-char-hex-secret-here
STATIC_ASSET_VERSION=20261014.1

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL credentials
# Use strong passwords in production!
POSTGRES_USER=minerva
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=minerva

# =============================================================================
# ODK Integration
# =============================================================================

# ODK credential encryption pepper — generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
ODK_CREDENTIAL_PEPPER=your-random-64-char-hex-secret-here

# =============================================================================
# Email / SMTP Configuration
# =============================================================================

# SMTP server for sending emails (forgot password, email verification)
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@digitva.org
# Public base URL (no trailing slash). REQUIRED in production: email links use
# it, and production refuses any request whose host is not this one (or
# localhost for the container healthcheck). Development and tests ignore it.
# PUBLIC_BASE_URL=https://digitva.example.org
# Optional: TLS certificate expiry monitoring (split production only; see
# docs/policy/tls-certificate-monitoring.md). Defaults shown.
# APP_TLS_CERT_FILE=/etc/digitva-app/tls/server.crt
# TLS_EXPIRY_WARN_DAYS=30
# TLS_EXPIRY_URGENT_DAYS=7
# TLS_HEALTH_DAILY_TIME=06:30
# Proof-of-work login CAPTCHA (docs/policy/authentication-factors.md section 5).
# REQUIRED in production; development/test derive a key from SECRET_KEY.
# `make ensure-secrets` (run by the dev/prod make targets) appends this and
# AUTH_FACTOR_ENCRYPTION_KEY (TOTP secret encryption; back it up) when absent.
# CAPTCHA_HMAC_KEY=
# AUTH_FACTOR_ENCRYPTION_KEY=
# Optional: expected work is 2^CAPTCHA_DIFFICULTY SHA-256 hashes (default 14,
# see config.py for the measurement behind that default).
# CAPTCHA_DIFFICULTY=14
# Optional: ISO date (YYYY-MM-DD) starting enrolment enforcement for
# privileged users (docs/policy/authentication-factors.md section 6). Unset
# means no enforcement.
# AUTH_FACTOR_ENFORCE_FROM=
# Optional: disable outbound delivery (keeps queueing logic but skips sending)
# EMAIL_DELIVERY_ENABLED=true
# Optional: Flask-Mail suppression switch (tests/CI typically set true)
# MAIL_SUPPRESS_SEND=false
# Optional: suppress recipient after permanent SMTP failure (seconds)
# EMAIL_SUPPRESSION_TTL_SECONDS=1209600
# Optional: Redis/cache key prefix for suppressed recipients
# EMAIL_SUPPRESSION_CACHE_PREFIX=digitva_email_suppressed:

# =============================================================================
# Attachment storage (config.py; docs/current-state/runtime-and-operations.md)
# =============================================================================
# 'local' (default) keeps files under APP_DATA/<form_id>/media/. 's3' keeps
# every attachment in a private bucket and serves it by a short-lived signed
# redirect. With 's3', the app refuses to start if a required key is missing;
# it never falls back to local disk.
# ATTACHMENT_STORE=local
# S3_SERVER=https://s3.<region>.amazonaws.com
# S3_BUCKET=<bucket-name>
# Derived from S3_SERVER for AWS endpoints; required otherwise.
# S3_REGION=<region>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional key prefix inside the bucket, one per environment sharing it, e.g.
# staging/ (the trailing slash is added if missing). Choose it before the first
# upload: objects are not moved if it changes later.
# S3_PREFIX=
# Signed-link lifetime in seconds (1..604800). Keep it short: the link is a
# bearer capability for the file.
# ATTACHMENT_PRESIGN_EXPIRY_SECONDS=300
# Minutes between sweeps that copy any still-local attachment into the bucket.
# ATTACHMENT_S3_UPLOAD_SWEEP_MINUTES=10

# =============================================================================
# Optional: External Service URLs (override defaults if needed)
# =============================================================================

# Redis — password required (set REDIS_PASSWORD, URLs are built from it in docker-compose.yml)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(24))"
REDIS_PASSWORD=your-random-48-char-hex-secret-here
REDIS_URL=redis://:your-random-48-char-hex-secret-here@minerva_redis_service:6379/0
CELERY_BROKER_URL=redis://:your-random-48-char-hex-secret-here@minerva_redis_service:6379/0
CELERY_RESULT_BACKEND=redis://:your-random-48-char-hex-secret-here@minerva_redis_service:6379/0
