{
  "expo": {
    "name": "DigitVA",
    "slug": "digitva-collect",
    "version": "0.3.19",
    "orientation": "default",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "scheme": "digitvacollect",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#e8edf0",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#0f1418"
          }
        }
      ],
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-local-authentication",
      "./plugins/with-android-dev-support",
      "./plugins/with-android-release-signing",
      "./plugins/with-android-abi-splits",
      "./plugins/with-android-legacy-gallery",
      "./plugins/with-android-theme",
      "./plugins/with-android-collect-plus",
      "./plugins/with-ios-collect-plus",
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan your enrolment QR code and photograph the written narrative and documents for an interview.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record the respondent's account of the death for the interview.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Scan your enrolment QR code and photograph the written narrative and documents for an interview."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DigitVA attaches photos you choose to a verbal autopsy interview.",
          "cameraPermission": "Scan your enrolment QR code and photograph the written narrative and documents for an interview.",
          "microphonePermission": "Record the respondent's account of the death for the interview."
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/app"
    },
    "android": {
      "package": "com.causeofdeathindia.digitvacollect",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.causeofdeathindia.digitvacollect",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "NSFaceIDUsageDescription": "DigitVA uses Face ID to unlock your encrypted interview data.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "icon": "./assets/icon.png"
  }
}
