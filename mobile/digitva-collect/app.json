{
  "expo": {
    "name": "DigitVA",
    "slug": "digitva-collect",
    "version": "0.2.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "scheme": "digitvacollect",
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "./plugins/with-android-dev-support",
      "./plugins/with-android-release-signing",
      "./plugins/with-android-abi-splits",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the enrolment QR code shown by your DigitVA administrator.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/app"
    },
    "android": {
      "package": "com.causeofdeathindia.digitvacollect",
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "ios": {
      "bundleIdentifier": "com.causeofdeathindia.digitvacollect",
      "infoPlist": {
        "NSFaceIDUsageDescription": "DigitVA uses Face ID to unlock your encrypted interview data."
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    }
  }
}
