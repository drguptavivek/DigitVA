{
  "expo": {
    "name": "DigitVA Collect",
    "slug": "digitva-collect",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "scheme": "digitvacollect",
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "./plugins/with-android-dev-support",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the enrolment QR code shown by your DigitVA administrator.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/app"
    },
    "android": {
      "package": "org.digitva.collect",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    }
  }
}
