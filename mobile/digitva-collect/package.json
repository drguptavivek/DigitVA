{
  "name": "digitva-collect",
  "version": "0.3.20",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "vendor:build": "npm --prefix ../../vendor/who-va-2022 run build && rm -rf node_modules/@drguptavivek/who-2022-va && npm install ../../vendor/who-va-2022",
    "start": "expo start",
    "web:hmr": "expo start --web --host lan --port 8081",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "ios": "expo run:ios",
    "ios:plus": "APP_VARIANT=plus expo run:ios",
    "build:debug": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "android:plus:dev": "APP_VARIANT=plus expo prebuild --platform android --clean --no-install && APP_VARIANT=plus expo run:android --variant debug",
    "android:plus:release": "APP_VARIANT=plus expo prebuild --platform android --clean --no-install && cd android && APP_VARIANT=plus ./gradlew assembleRelease",
    "export:web": "expo export --platform web && mkdir -p dist/ui-strings && cp src/strings/*.json dist/ui-strings/ && node scripts/export-form-ui-strings.mjs dist/ui-strings",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "setupFiles": [
      "./node_modules/react-native-gesture-handler/jestSetup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@drguptavivek/who-2022-va$": "<rootDir>/../../vendor/who-va-2022/dist/index.js",
      "^@drguptavivek/who-2022-va/native$": "<rootDir>/../../vendor/who-va-2022/dist/native.js"
    }
  },
  "dependencies": {
    "@drguptavivek/who-2022-va": "file:../../vendor/who-va-2022",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.21",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "^57.0.7",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.21",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "^57.0.6",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "^57.0.3",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.23",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-screen-capture": "~57.0.3",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "^57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-task-manager": "~57.0.21",
    "jpeg-js": "0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.0",
    "react-native-document-scanner-plugin": "2.0.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-paper-dates": "0.23.16",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-sharing"
        ]
      }
    }
  }
}
