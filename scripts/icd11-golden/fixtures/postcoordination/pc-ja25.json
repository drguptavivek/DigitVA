   "name": "details",
   "reply": {
    "body": {
     "coding_note": "",
     "definition": "Any condition affecting pregnant females, characterised by seizure or convulsions newly arising in pregnancy. The condition is often associated with pregnancy-induced hypertension, convulsions, seizure, anxiety, epigastric pain, severe headache, blurred vision, proteinuria, and oedema that may occur during pregnancy, labour, or the puerperium.",
