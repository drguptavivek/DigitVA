  "GET icd/release/11/2026-01/mms/183230446": {"method":"GET","path":"icd/release/11/2026-01/mms/183230446","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/183230446","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#183230446","child":["http://id.who.int/icd/release/11/2026-01/mms/1126579721","http://id.who.int/icd/release/11/2026-01/mms/644739997","http://id.who.int/icd/release/11/2026-01/mms/1388356450","http://id.who.int/icd/release/11/2026-01/mms/931884792","http://id.who.int/icd/release/11/2026-01/mms/1147534692","http://id.who.int/icd/release/11/2026-01/mms/183230446/other","http://id.who.int/icd/release/11/2026-01/mms/183230446/unspecified"],"classKind":"category","code":"JA20","definition":{"@language":"en","@value":"A condition affecting pregnant females, caused by previously diagnosed maternal hypertension. This condition is characterised by any complication during pregnancy, childbirth, and the puerperium as a result of a blood pressure reading above 140/90 mmHg prior to the 20th week of pregnancy, or persisting longer than 12 weeks postpartum. Confirmation is by sphygmomanometer."},"exclusion":[{"foundationReference":"http://id.who.int/icd/entity/1872761464","label":{"@language":"en","@value":"Pre-eclampsia superimposed on chronic hypertension"},"linearizationReference":"http://id.who.int/icd/release/11/2026-01/mms/1872761464"}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/1042184245"],"source":"http://id.who.int/icd/entity/183230446","title":{"@language":"en","@value":"Pre-existing hypertension complicating pregnancy, childbirth or the puerperium"}},"request_body":null,"status":200},
  "GET icd/release/11/2026-01/mms/1872761464": {"method":"GET","path":"icd/release/11/2026-01/mms/1872761464","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/1872761464","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#1872761464","classKind":"category","code":"JA21","definition":{"@language":"en","@value":"A condition affecting pregnant females over 20 weeks gestation. This condition is characterised by systolic blood pressure greater than 140mmHg and diastolic greater or equal to 90mmHg on two occasions 4 hours apart in the presence of either proteinuria or other new onset maternal organ dysfunction characterised by one thrombocytopenia, elevated serum creatinine or liver transaminases, or neurological conditions or fetal growth restriction in a female diagnosed with pre-existing hypertension."},"inclusion":[{"label":{"@language":"en","@value":"Superimposed pre-eclampsia"}}],"indexTerm":[{"label":{"@language":"en","@value":"Pre-eclampsia superimposed on chronic hypertension"}},{"label":{"@language":"en","@value":"Pre-eclampsia superimposed on hypertension NOS"}},{"label":{"@language":"en","@value":"Pre-eclampsia superimposed on pre-existing hypertension"}},{"label":{"@language":"en","@value":"Pre-existing hypertension complicating pregnancy, childbirth and the puerperium complicated by pre-eclampsia"}},{"label":{"@language":"en","@value":"Superimposed pre-eclampsia"}},{"label":{"@language":"en","@value":"pre-eclampsia added to pre-existing hypertension"}},{"label":{"@language":"en","@value":"pre-eclampsia or eclampsia with pre-existing hypertension"}},{"label":{"@language":"en","@value":"pre-existing hypertensive disorder with superimposed proteinuria"}},{"label":{"@language":"en","@value":"proteinuria complicating pregnancy, childbirth or puerperium, superimposed on pre-existing hypertensive disorder"}},{"label":{"@language":"en","@value":"puerperal pre-eclampsia with pre-existing hypertension"}},{"label":{"@language":"en","@value":"superimposed PET - [pre-eclamptic toxaemia]"}},{"label":{"@language":"en","@value":"superimposed PIH - [pregnancy-induced hypertension]"}}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/1042184245"],"postcoordinationScale":[{"@id":"http://id.who.int/icd/release/11/2026-01/mms/1872761464/postcoordinationScale/associatedWith","allowMultipleValues":"AllowAlways","axisName":"http://id.who.int/icd/schema/associatedWith","requiredPostcoordination":"false","scaleEntity":["http://id.who.int/icd/release/11/2026-01/mms/761947693","http://id.who.int/icd/release/11/2026-01/mms/1210166201","http://id.who.int/icd/release/11/2026-01/mms/1015872326","http://id.who.int/icd/release/11/2026-01/mms/1002963291","http://id.who.int/icd/release/11/2026-01/mms/1331849426"]}],"source":"http://id.who.int/icd/entity/1872761464","title":{"@language":"en","@value":"Pre-eclampsia superimposed on chronic hypertension"}},"request_body":null,"status":200},
  "GET icd/release/11/2026-01/mms/1959180957": {"method":"GET","path":"icd/release/11/2026-01/mms/1959180957","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/1959180957","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#1959180957","classKind":"category","code":"JA25.2","definition":{"@language":"en","@value":"This condition is characterised by seizure or convulsions newly arising in pregnancy. The condition is often associated with pregnancy-induced hypertension, convulsions, seizure, anxiety, epigastric pain, severe headache, blurred vision, proteinuria, and oedema that occurs during the puerperium."},"indexTerm":[{"label":{"@language":"en","@value":"Eclampsia in the puerperium"}},{"label":{"@language":"en","@value":"postpartum eclampsia"}},{"label":{"@language":"en","@value":"puerperal eclampsia"}}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/1759760659"],"source":"http://id.who.int/icd/entity/1959180957","title":{"@language":"en","@value":"Eclampsia in the puerperium"}},"request_body":null,"status":200},
  "GET icd/release/11/2026-01/mms/2118553363": {"method":"GET","path":"icd/release/11/2026-01/mms/2118553363","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/2118553363","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#2118553363","classKind":"category","code":"JA23","definition":{"@language":"en","@value":"A condition affecting pregnant females, characterised by systolic blood pressure greater than 140mmHg and/or a diastolic blood pressure greater or equal to 90mmHg on two occasions, 4 hours or more apart. Can be newly diagnosed after 20 weeks gestation or before 1 week postpartum. Confirmation is by measurement of blood pressure, liver and kidney functions test, and urine test."},"indexTerm":[{"label":{"@language":"en","@value":"Gestational hypertension"}},{"label":{"@language":"en","@value":"Gestational hypertension NOS"}},{"label":{"@language":"en","@value":"PIH - [pregnancy-induced hypertension]"}},{"label":{"@language":"en","@value":"Pregnancy-induced hypertension NOS"}},{"label":{"@language":"en","@value":"gestational [pregnancy-induced] hypertension without significant proteinuria"}},{"label":{"@language":"en","@value":"hypertension induced by pregnancy"}},{"label":{"@language":"en","@value":"mild proteinuric hypertension of pregnancy"}}],"longDefinition":{"@language":"en","@value":"Blood pressure of 140 mm Hg or greater systolic and/or 90 mm Hg or greater diastolic occuring for the first time during pregnancy and in the absence of proteinuria"},"parent":["http://id.who.int/icd/release/11/2026-01/mms/1042184245"],"postcoordinationScale":[{"@id":"http://id.who.int/icd/release/11/2026-01/mms/2118553363/postcoordinationScale/associatedWith","allowMultipleValues":"AllowAlways","axisName":"http://id.who.int/icd/schema/associatedWith","requiredPostcoordination":"false","scaleEntity":["http://id.who.int/icd/release/11/2026-01/mms/761947693"]}],"source":"http://id.who.int/icd/entity/2118553363","title":{"@language":"en","@value":"Gestational hypertension"}},"request_body":null,"status":200},
  "GET icd/release/11/2026-01/mms/229121159": {"method":"GET","path":"icd/release/11/2026-01/mms/229121159","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/229121159","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#229121159","child":["http://id.who.int/icd/release/11/2026-01/mms/2044260215","http://id.who.int/icd/release/11/2026-01/mms/479404771","http://id.who.int/icd/release/11/2026-01/mms/1748922908","http://id.who.int/icd/release/11/2026-01/mms/229121159/unspecified"],"classKind":"category","code":"JA24","definition":{"@language":"en","@value":"This condition is characterised by systolic blood pressure greater than 140 mmHg and/or diastolic greater or equal to 90 mmHg on two occasions 4 hours or more apart in the presence of either proteinuria or other new onset maternal organ dysfunction characterised by one thrombocytopenia, elevated serum creatinine or liver transaminases, or neurological conditions or fetal growth restriction."},"exclusion":[{"foundationReference":"http://id.who.int/icd/entity/1872761464","label":{"@language":"en","@value":"Pre-eclampsia superimposed on chronic hypertension"},"linearizationReference":"http://id.who.int/icd/release/11/2026-01/mms/1872761464"}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/1042184245"],"postcoordinationScale":[{"@id":"http://id.who.int/icd/release/11/2026-01/mms/229121159/postcoordinationScale/associatedWith","allowMultipleValues":"AllowAlways","axisName":"http://id.who.int/icd/schema/associatedWith","requiredPostcoordination":"false","scaleEntity":["http://id.who.int/icd/release/11/2026-01/mms/1902649856","http://id.who.int/icd/release/11/2026-01/mms/337899414","http://id.who.int/icd/release/11/2026-01/mms/1619967851","http://id.who.int/icd/release/11/2026-01/mms/96826111","http://id.who.int/icd/release/11/2026-01/mms/1982587243","http://id.who.int/icd/release/11/2026-01/mms/973282267/unspecified"]}],"source":"http://id.who.int/icd/entity/229121159","title":{"@language":"en","@value":"Pre-eclampsia"}},"request_body":null,"status":200},
  "GET icd/release/11/2026-01/mms/250375350": {"method":"GET","path":"icd/release/11/2026-01/mms/250375350","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/250375350","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#250375350","classKind":"category","code":"JA25.3","definition":{"@language":"en","@value":"Onset of convulsions in a woman with pre-eclampsia not attributable to other causes without a specific onset time."},"indexTerm":[{"label":{"@language":"en","@value":"Eclampsia, time period unspecified"}},{"label":{"@language":"en","@value":"Eclampsia NOS"}},{"label":{"@language":"en","@value":"eclamptic coma"}},{"label":{"@language":"en","@value":"eclamptic toxaemia"}},{"label":{"@language":"en","@value":"toxaemia with convulsions"}},{"foundationReference":"http://id.who.int/icd/entity/1979552354","label":{"@language":"en","@value":"Convulsions following gestational [pregnancy-induced] hypertension with significant proteinuria"}},{"foundationReference":"http://id.who.int/icd/entity/718945235","label":{"@language":"en","@value":"Convulsions following gestational [pregnancy-induced] hypertension without significant proteinuria"}},{"foundationReference":"http://id.who.int/icd/entity/890149511","label":{"@language":"en","@value":"Convulsions following gestational [pregnancy-induced] oedema and proteinuria without hypertension"}},{"foundationReference":"http://id.who.int/icd/entity/1893793650","label":{"@language":"en","@value":"Convulsions following pre-existing hypertension complicating pregnancy, childbirth and the puerperium"}},{"foundationReference":"http://id.who.int/icd/entity/826685717","label":{"@language":"en","@value":"Convulsions following pre-existing hypertensive disorder with superimposed proteinuria"}},{"foundationReference":"http://id.who.int/icd/entity/2143063924","label":{"@language":"en","@value":"Convulsions following unspecified maternal hypertension