  "GET icd/release/11/2026-01/mms/7072356": {"method":"GET","path":"icd/release/11/2026-01/mms/7072356","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/7072356","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#7072356","classKind":"category","code":"JA25.1","definition":{"@language":"en","@value":"This condition is characterised by seizure or convulsions newly arising in pregnancy. The condition is often associated with pregnancy-induced hypertension, convulsions, seizure, anxiety, epigastric pain, severe headache, blurred vision, proteinuria, and oedema that occurs during labour."},"indexTerm":[{"label":{"@language":"en","@value":"Eclampsia in labour"}}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/1759760659"],"source":"http://id.who.int/icd/entity/7072356","title":{"@language":"en","@value":"Eclampsia in labour"}},"request_body":null,"status":200},
