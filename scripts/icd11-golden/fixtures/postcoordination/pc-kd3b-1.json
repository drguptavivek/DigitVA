  "GET icd/release/11/2026-01/mms/1947342847": {"method":"GET","path":"icd/release/11/2026-01/mms/1947342847","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/1947342847","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#1947342847","classKind":"category","code":"KD3B.0","codingNote":{"@language":"en","@value":"Not to be used for the underlying cause of death of live births.\nNot to be used for the underlying cause of fetal death, if any other cause of fetal mortality is known."},"definition":{"@language":"en","@value":"Antepartum fetal death is a fetal death before the onset of labour. If vital status of the fetus at the onset of labour is unknown, consider it was antepartum if there is presence of signs of maceration at the time of delivery.\n\nMacerated stillbirth - is the complete expulsion or extraction from a woman of a fetus following a fetal death at 22 or more completed weeks of gestation; or if gestational age is not available with a birthweight of 500g or more with skin showing signs of maceration.\n\nAntepartum stillbirth - is the complete expulsion or extraction from a woman of a fetus following an antepartum fetal death at 22 or more completed weeks of gestation; or if gestational age is not available with a birthweight of 500 grams or more."},"inclusion":[{"label":{"@language":"en","@value":"antepartum stillbirth"}},{"label":{"@language":"en","@value":"macerated stillbirth"}}],"indexTerm":[{"label":{"@language":"en","@value":"Antepartum fetal death"}},{"label":{"@language":"en","@value":"antepartum stillbirth"}},{"label":{"@language":"en","@value":"macerated stillbirth"}}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/505744734"],"source":"http://id.who.int/icd/entity/1947342847","title":{"@language":"en","@value":"Antepartum fetal death"}},"request_body":null,"status":200},
  "GET icd/release/11/2026-01/mms/2034327580": {"method":"GET","path":"icd/release/11/2026-01/mms/2034327580","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/2034327580","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#2034327580","classKind":"category","code":"KD3B.1","codingNote":{"@language":"en","@value":"Not to be used for the underlying cause of death of live births.\nNot to be used for the underlying cause of fetal death, if any other cause of fetal mortality is known."},"definition":{"@language":"en","@value":"Intrapartum fetal death is a fetal death during labour. If vital status of the fetus at the onset of labour is unknown, consider it was intrapartum if there is fresh skin appearance or no signs of maceration at the time of delivery.\n\nIntrapartum stillbirth - is the complete expulsion or extraction from a woman of a fetus following an intrapartum fetal death at 22 or more completed weeks of gestation; or if gestational age is not available with a birthweight of 500 grams or more."},"inclusion":[{"label":{"@language":"en","@value":"fresh stillbirth"}},{"label":{"@language":"en","@value":"intrapartum stillbirth"}}],"indexTerm":[{"label":{"@language":"en","@value":"Intrapartum fetal death"}},{"label":{"@language":"en","@value":"fresh stillbirth"}},{"label":{"@language":"en","@value":"intrapartum stillbirth"}}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/505744734"],"source":"http://id.who.int/icd/entity/2034327580","title":{"@language":"en","@value":"Intrapartum fetal death"}},"request_body":null,"status":200},
  "GET icd/release/11/2026-01/mms/505744734": {"method":"GET","path":"icd/release/11/2026-01/mms/505744734","reply":{"@context":"http://id.who.int/icd/contexts/contextForLinearizationEntity.json","@id":"http://id.who.int/icd/release/11/2026-01/mms/505744734","browserUrl":"https://icd.who.int/browse/2026-01/mms/en#505744734","child":["http://id.who.int/icd/release/11/2026-01/mms/1947342847","http://id.who.int/icd/release/11/2026-01/mms/2034327580","http://id.who.int/icd/release/11/2026-01/mms/505744734/unspecified"],"classKind":"category","code":"KD3B","codingNote":{"@language":"en","@value":"Not to be used for the underlying cause of death of live births.\nNot to be used for the underlying cause of fetal death, if any other cause of fetal mortality is known."},"definition":{"@language":"en","@value":"Fetal death is death of a fetus prior to its complete expulsion or extraction from a woman, irrespective of the duration of pregnancy. Fetal death may be diagnosed in utero by absence of fetal heart sounds, confirmed by imaging techniques where available, or after delivery by absence of signs of life after the complete expulsion or extraction from the woman.\n\nStillbirth is the complete expulsion or extraction from a woman of a fetus, following its death prior to the complete expulsion or extraction, at 22 or more completed weeks of gestation."},"inclusion":[{"label":{"@language":"en","@value":"calcified fetus"}},{"label":{"@language":"en","@value":"fetus maceration"}},{"label":{"@language":"en","@value":"lithopedion fetus"}},{"label":{"@language":"en","@value":"osteopedion fetus"}},{"label":{"@language":"en","@value":"stillbirth NOS"}},{"label":{"@language":"en","@value":"stillborn NOS"}}],"parent":["http://id.who.int/icd/release/11/2026-01/mms/861066692"],"source":"http://id.who.int/icd/entity/505744734","title":{"@language":"en","@value":"Fetal death, cause not specified"}},"request_body":null,"status":200},
