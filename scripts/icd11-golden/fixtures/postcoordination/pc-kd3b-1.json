   "name": "details",
   "reply": {
    "body": {
     "coding_note": "Not to be used for the underlying cause of death of live births.\nNot to be used for the underlying cause of fetal death, if any other cause of fetal mortality is known.",
     "definition": "Intrapartum fetal death is a fetal death during labour. If vital status of the fetus at the onset of labour is unknown, consider it was intrapartum if there is fresh skin appearance or no signs of maceration at the time of delivery.\n\nIntrapartum stillbirth - is the complete expulsion or extraction from a woman of a fetus following an intrapartum fetal death at 22 or more completed weeks of gestation; or if gestational age is not available with a birthweight of 500 grams or more.",
     "exclusions": [],
     "fully_specified_name": "",
     "inclusions": [
      "fresh stillbirth",
      "intrapartum stillbirth"
     ],
     "release": "2026-01",
